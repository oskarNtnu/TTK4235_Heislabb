@startuml state diagram

state ElevatorRunning {
    [*] --> OnFloor

    OnFloor --> MovingUp 
    MovingUp --> OnFloor
    OnFloor --> MovingDown 
    MovingDown --> OnFloor
    OnFloor --> DoorOpen
    DoorOpen --> OnFloor
    Obstruction --> DoorOpen
    DoorOpen --> Obstruction

    
}

state Stop 
ElevatorRunning --> Stop
Stop --> ElevatorRunning


@enduml